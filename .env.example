# Leave empty for offline hash embeddings and a keyword ranker (for trying the plumbing only).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_RANKING_MODEL=openai/gpt-oss-20b
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_RANKING_PROVIDER_SORT=throughput
QDRSS_DATA_DIR=data
QDRSS_SOURCES=sources.yaml
QDRSS_HOST=127.0.0.1
QDRSS_PORT=8000
QDRSS_REFRESH_MINUTES=60
# Used when a request has no since=.
QDRSS_WINDOW_DAYS=7
QDRSS_CANDIDATE_COUNT=40
QDRSS_DEFAULT_LIMIT=20
QDRSS_MAX_LIMIT=100
QDRSS_RANKING_BATCH_SIZE=5
